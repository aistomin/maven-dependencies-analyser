<?xml version="1.0" encoding="UTF-8"?>
<!--
    The fixture for the mapping of the dependency's <type> onto the
    packaging type of the artifact. It declares one dependency per
    interesting case:

    - inherited-type omits the type, which Maven defaults to "jar".
    - explicit-jar spells the same type out.
    - web-app uses "war", one of the types the enum does know.
    - test-fixtures uses "test-jar", which the enum does not know. It must
      become UNKNOWN, never NULL: the artifact is analysable, only its
      packaging is none of the ones we can name.

    The artifacts live in the com.github.aistomin group on purpose. That
    namespace belongs to this project's author, so these coordinates can not
    be taken by somebody else. Nothing is ever looked up in Maven Central
    here anyway - the fixture is only parsed.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.github.aistomin</groupId>
    <artifactId>types-test</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Maven Dependencies Analyser</name>
    <description>A pom.xml with the dependencies of the various types.</description>
    <url>https://github.com/aistomin/maven-dependencies-analyser</url>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.github.aistomin</groupId>
            <artifactId>inherited-type</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>com.github.aistomin</groupId>
            <artifactId>explicit-jar</artifactId>
            <version>2.0</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>com.github.aistomin</groupId>
            <artifactId>web-app</artifactId>
            <version>3.0</version>
            <type>war</type>
        </dependency>
        <dependency>
            <groupId>com.github.aistomin</groupId>
            <artifactId>test-fixtures</artifactId>
            <version>4.0</version>
            <type>test-jar</type>
        </dependency>
    </dependencies>
</project>
